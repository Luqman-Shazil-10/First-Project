.MODEL SMALL
.STACK 100H

.DATA
MAXSLOTS DB 5
CARCOUNT DB 0
MSG1 DB "Parking Full!$"
MSG2 DB "Car Parked Successfully!$"

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    MOV AL, CARCOUNT
    CMP AL, MAXSLOTS
    JE FULL

    INC CARCOUNT
    LEA DX, MSG2
    MOV AH, 09H
    INT 21H
    JMP EXIT

FULL:
    LEA DX, MSG1
    MOV AH, 09H
    INT 21H

EXIT:
    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
